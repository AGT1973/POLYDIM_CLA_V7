+static inline void* pmtp2_payload_of(PMTP_Control* c, uint32_t slot) {
+    return reinterpret_cast<void*>(
+        reinterpret_cast<char*>(c) + sizeof(PMTP_Control)
+        + static_cast<size_t>(c->num_slots) * sizeof(PMTP_SlotHeader)
+        + static_cast<size_t>(slot) * static_cast<size_t>(c->payload_bytes)
+    );
+}
+
+extern "C" POLYDIM_EXPORT void* POLYDIM_CALL polydim_pmtp_payload_ptr(PMTP_Control* c, uint32_t slot) {
+    try {
+        if (!c || slot >= c->num_slots) return nullptr;
+        return pmtp2_payload_of(c, slot);
+    } catch (...) { return nullptr; }
+}
